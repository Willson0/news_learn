# Домен, на котором будет открываться мини-приложение (A-запись должна
# указывать на IP сервера). HTTPS-сертификат выпустится автоматически.
DOMAIN=app.example.ru
APP_URL=https://app.example.ru
FRONTEND_URL=https://app.example.ru

APP_NAME="Карта Ликвидности"
APP_LOCALE=ru
# Оставьте пустым — ключ сгенерируется сам при первом запуске
APP_KEY=

# Токен бота от @BotFather — обязателен для входа через Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_INSECURE=false

# Наполнить базу демо-отчётами и чатами при первом запуске
SEED_DEMO_DATA=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Логи: файл storage/logs/laravel.log и одновременно stderr (docker compose logs).
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=info

# Почта: коды подтверждения регистрации и восстановления пароля.
# По умолчанию MAIL_MAILER=log — письма не уходят, код пишется в лог
# (storage/logs/laravel.log). Для реальной отправки укажите SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.yandex.ru
#   MAIL_PORT=465
#   MAIL_USERNAME=you@yandex.ru
#   MAIL_PASSWORD=app-password
#   MAIL_SCHEME=smtps
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@wilflw.ru"
MAIL_FROM_NAME="${APP_NAME}"

# Push-уведомления (Firebase Cloud Messaging). Без них push не уходит.
#FCM_PROJECT_ID=
#FCM_CREDENTIALS=/app/backend/storage/app/fcm.json

# Оплата через Т-Кассу: счета из админки и автопродление подписки.
# В терминале Т-Кассы укажите URL уведомлений: https://<домен>/api/tbank/webhook
#TBANK_TERMINAL_KEY=
#TBANK_PASSWORD=
