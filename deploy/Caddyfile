{
	frankenphp
}

# DOMAIN — домен из deploy/.env (например app.example.ru). Caddy сам выпускает
# и продлевает сертификат Let's Encrypt. Для проверки без домена: DOMAIN=:80
{$DOMAIN} {
	encode zstd gzip

	# Laravel API (и служебный /up для проверки здоровья)
	# Админка (/admin) и её API тоже идут в Laravel, а не в статику Vue.
	@backend path /api/* /up /admin /admin/* /build/*
	handle @backend {
		root * /app/backend/public
		php_server
	}

	# Vue-приложение: статика + fallback на index.html для history-роутинга
	handle {
		root * /app/frontend
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
