<?xml version="1.0" encoding="utf-8"?>
<!--
  Только для debug-сборки: разрешаем незашифрованный HTTP, чтобы можно было
  тестировать приложение против локального бэкенда (например http://10.0.2.2:8000/api/)
  в эмуляторе. В release-сборке остаётся запрет cleartext по умолчанию.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
