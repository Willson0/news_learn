<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Karta" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Сплэш при запуске (SplashScreen API): логотип на фоне приложения, пока грузится сессия. -->
    <style name="Theme.Karta.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Karta</item>
    </style>
</resources>
