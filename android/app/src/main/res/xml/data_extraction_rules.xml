<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: данные приложения (в том числе токен входа) не попадают ни в облачную копию, ни в перенос на другое устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
