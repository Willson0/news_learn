# Переменные окружения для сборки Android-приложения (Capacitor).
# Используются командами `npm run build:android` / `sync:android` / `run:android`
# (vite build --mode capacitor).
#
# В вебе фронт и API живут на одном домене, поэтому там достаточно
# относительного пути `/api`. В нативном приложении ассеты открываются с
# локальной схемы (https://localhost), поэтому API нужно указать абсолютным
# URL до РАЗВЁРНУТОГО бэкенда Laravel.
#
# ЗАМЕНИТЕ значение ниже на адрес вашего бэкенда перед сборкой APK:
VITE_API_BASE=https://REPLACE-WITH-YOUR-BACKEND-HOST/api
